# Public-only configuration. Copy to apps/web/.env.local and fill locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER set Supabase secret/service_role keys in client-visible env.

# Server-only feature gate, false unless preview/staging has passed RLS/Auth/Storage tests.
ENABLE_MARKETPLACE_WRITES=false
